    "deny": [
      "Bash(git config --global:*)",
      "Bash(git config --system:*)",
      "Bash(env)",
      "Bash(printenv:*)",

      "Bash(sudo:*)",
      "Bash(su:*)",
      "Bash(doas:*)",
      "Bash(systemctl:*)",
      "Bash(service:*)",

      "Bash(nc:*)",
      "Bash(netcat:*)",
      "Bash(ssh:*)",
      "Bash(scp:*)",
      "Bash(rsync:*)",
      "Bash(curl:*)",
      "Bash(wget:*)",
      "Bash(http:*)",

      "Read(~/.aws/**)",
      "Read(~/.ssh/**)",
      "Read(**/*.env)",
      "Read(**/.env)",
      "Read(**/.env.*)",
      "Read(**/secrets/**)",
      "Read(**/.secret*)",
      "Read(**/id_rsa*)",
      "Read(**/id_ed25519*)",
      "Read(~/.gnupg/**)",
      "Read(/etc/passwd)",
      "Read(/etc/shadow)",
      "Read(/etc/sudoers*)",

      "Write(/etc/**)",
      "Write(/usr/**)",
      "Write(/bin/**)",
      "Write(/sbin/**)",
      "Write(~/.ssh/**)",
      "Write(~/.aws/**)",
      "Write(~/.config/**)",
      "Write(~/.cache/**)",
      "Write(**/*.env)",
      "Write(**/.env.*)",
      "Write(**/.env)",
      "Write(**/.git/**)"
    ]
  },
  "spinnerVerbs": {
    "mode": "replace",
    "verbs": [
      "Working"
    ]
  },
  "statusLine": {
    "command": "claude-powerline --style=powerline",
    "type": "command"
  },
  "terminalProgressBarEnabled": true,
  "theme": "dark"
}
