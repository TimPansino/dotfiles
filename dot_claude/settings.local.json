      "Bash(git branch -v:*)",
      "Bash(git branch -a:*)",
      "Bash(git branch -r:*)",
      "Bash(git tag)",
      "Bash(git tag --list:*)",
      "Bash(git tag -l:*)",
      "Bash(git remote)",
      "Bash(git remote -v)",
      "Bash(git remote show:*)",
