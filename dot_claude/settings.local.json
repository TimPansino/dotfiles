{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "alwaysThinkingEnabled": true,
  "planMode": true,
  "attribution": {
    "commit": "",
    "pr": ""
  },
  "editorMode": "vim",
  "hooks": {
    "Notification": [
      {
        "hooks": [
          {
            "command": "afplay /System/Library/Sounds/Submarine.aiff &",
            "type": "command"
          },
          {
            "command": "printf '\\a' > /dev/tty",
            "type": "command"
          }
        ],
        "matcher": "permission_prompt|elicitation_dialog|idle_prompt"
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "command": "afplay /System/Library/Sounds/Glass.aiff &",
            "type": "command"
          },
          {
            "command": "printf '\\a' > /dev/tty",
            "type": "command"
          }
        ]
      }
    ]
  },
  "outputStyle": "Explanatory",
  "permissions": {
    "defaultMode": "plan",
    "allow": [
      "Find",
      "Read",
      "List",
      "Search",
      "Get",
      "Grep",
      "Glob",

      "WebSearch",
      "WebFetch(domain:anthropic.com)",
      "WebFetch(domain:docs.aws.amazon.com)",
      "WebFetch(domain:claude.com)",
      "WebFetch(domain:formulae.brew.sh)",
      "WebFetch(domain:github.com)",
      "WebFetch(domain:raw.githubusercontent.com)",
      "WebFetch(domain:www.schemastore.org)",

      "Bash(ls:*)",
      "Bash(pwd)",
      "Bash(stat:*)",
      "Bash(file:*)",
      "Bash(tree:*)",
      "Bash(wc:*)",
      "Bash(du:*)",
      "Bash(df:*)",
      "Bash(realpath:*)",
      "Bash(readlink:*)",
      "Bash(basename:*)",
      "Bash(dirname:*)",

      "Bash(cat:*)",
      "Bash(head:*)",
      "Bash(tail:*)",
      "Bash(less:*)",
      "Bash(more:*)",
      "Bash(zcat:*)",
      "Bash(column:*)",

      "Bash(grep:*)",
      "Bash(rg:*)",
      "Bash(ag:*)",
      "Bash(fd:*)",
      "Bash(sort:*)",
      "Bash(uniq:*)",
      "Bash(diff:*)",
